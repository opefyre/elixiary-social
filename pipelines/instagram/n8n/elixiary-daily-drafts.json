{
  "name": "Elixiary \u2014 Instagram daily drafts",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "sched-1",
      "name": "Every day 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -260,
        0
      ]
    },
    {
      "parameters": {},
      "id": "manual-1",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -260,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8787/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ recipes: 4, articles: 1, dry_run: false }) }}",
        "options": {
          "timeout": 1500000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "exec-1",
      "name": "Build 4 recipes + 1 article",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -20,
        100
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// The service returns {ok, exitCode, summary:{...}}\nconst r = $input.first().json;\nconst s = r.summary || {};\nreturn [{ json: {\n  ok: (s.succeeded || 0) > 0,\n  requested: s.requested ?? 0,\n  succeeded: s.succeeded ?? 0,\n  failed: s.failed ?? 0,\n  drafts: s.drafts || [],\n  results: s.results || [],\n  exitCode: r.exitCode,\n  stderr: (r.stderr || '').slice(-800),\n}}];"
      },
      "id": "parse-1",
      "name": "Parse summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "if-1",
      "name": "Any drafts created?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        420,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $input.first().json;\nconst when = new Date().toISOString();\nconst lines = (s.results || []).map(r =>\n  `${r.ok ? 'ok' : 'FAILED'}  ${r.type}  ${r.detail || ''}`);\nreturn [{ json: {\n  headline: `${s.succeeded}/${s.requested} drafts created`,\n  drafts: s.drafts,\n  detail: lines,\n  reviewUrl: 'https://publish.buffer.com/drafts',\n  ranAt: when,\n}}];"
      },
      "id": "ok-1",
      "name": "Drafts ready to review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "errorMessage": "={{ 'Elixiary daily run produced no drafts: ' + JSON.stringify($json.results || $json.reason) }}"
      },
      "id": "err-1",
      "name": "Nothing was created",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        660,
        220
      ]
    }
  ],
  "connections": {
    "Every day 09:00": {
      "main": [
        [
          {
            "node": "Build 4 recipes + 1 article",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run manually": {
      "main": [
        [
          {
            "node": "Build 4 recipes + 1 article",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse summary": {
      "main": [
        [
          {
            "node": "Any drafts created?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any drafts created?": {
      "main": [
        [
          {
            "node": "Drafts ready to review",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Nothing was created",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build 4 recipes + 1 article": {
      "main": [
        [
          {
            "node": "Parse summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Lisbon",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "executionTimeout": 2400
  },
  "pinData": {}
}
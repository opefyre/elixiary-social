# ─── SECRETS — never commit ────────────────────────────────────────────
# Supabase credentials (Postgres connection string + sbp_ PAT)
supabase.txt
supabaseapi.txt
# Buffer GraphQL API key
bufferapi.txt
# Cloudflare API token (Workers AI)
cloudflaretoken.txt

# Generic secret patterns — belt and braces
.env
.env.*
!.env.example
*.env
secrets/
**/secrets.*
*secret*
*credential*
# ...but this one only *resolves* credentials, it never holds a value.
# It is imported by everything, so the repo will not run without it.
!pipelines/instagram/credentials.py
*.pem
*.key
*.p8
*.p12
*.keystore
*token*
!**/tokenizer*
service-account*.json
gcp-*.json
client_secret*.json
.wrangler/
.dev.vars
.dev.vars.*

# n8n exports may embed credentials — audit before un-ignoring
n8n/**/credentials*.json
*.credentials.json

# ─── OS / editor ───────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
*.swp
.idea/
.vscode/

# ─── Node ──────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.cache/

# ─── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ─── Scratch / local working files ─────────────────────────────────────
scratch/
tmp/
*.local.*

# ─── Local-only Claude workspace (ops skill stays off GitHub) ──────────
.claude/

# local tool installs (wrangler, for the one-off Drive -> R2 mirror).
# The manifest stays so `npm install --prefix .tools` can rebuild it; the
# 234MB of node_modules does not belong in git.
.tools/*
!.tools/package.json

# local pipeline state (SQLite) — not shared, machine-specific
pipelines/instagram/state/*.db
pipelines/instagram/state/*.db-wal
pipelines/instagram/state/*.db-shm
pipelines/instagram/scripts/mirror-failures.json

# contained Chromium fetched by puppeteer
pipelines/instagram/render/.chromium/
pipelines/instagram/render/.puppeteer/
pipelines/instagram/node_modules/

# cached remote images used by photo slides
pipelines/instagram/render/.imgcache/

# derived on each machine: tempo catalogue and per-reel track rotation log
pipelines/instagram/reels/music/.catalogue.json
pipelines/instagram/reels/.music-used.json
